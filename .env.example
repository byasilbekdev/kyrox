# ── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ── Telegram ─────────────────────────────────────────
BOT_TOKEN=123456:ABC-your-bot-token

# Telegram numeric ID that gets auto-provisioned as the
# first Owner on bootstrap if no Owner exists yet.
BOOTSTRAP_OWNER_TELEGRAM_ID=123456789

# Set to your Render external URL in production to enable
# webhook mode. Leave empty in development to use long polling.
WEBHOOK_URL=

# Random 16+ char secret; Telegram echoes it back on every
# webhook call so we can verify the request actually came
# from Telegram and not a random POST to our endpoint.
WEBHOOK_SECRET=change-me-to-a-random-32-char-string

# ── Database ─────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/kyrox

# ── Redis (Upstash REST) ─────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ── AI Providers ─────────────────────────────────────
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Defaults used when an Owner has not configured these yet.
DEFAULT_AI_MODEL=google/gemini-2.5-flash
DEFAULT_AI_TEMPERATURE=0.7
DEFAULT_AI_MAX_TOKENS=1000

# ── Rate limiting ────────────────────────────────────
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60